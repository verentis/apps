{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/surveys/v1/survey.schema.json",
  "title": "Surveys survey",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/surveys/v1/survey.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "survey"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "status": {
      "enum": [
        "draft",
        "open",
        "closed"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "enum": [
              "text",
              "single-choice",
              "multi-choice",
              "rating"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "minItems": 0,
            "maxItems": 50
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "sequence",
          "text",
          "kind",
          "choices",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "openedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "title",
    "description",
    "status",
    "questions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "openedAt": true
        },
        "required": [
          "openedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "closed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "closedAt": true
        },
        "required": [
          "closedAt"
        ]
      }
    }
  ]
}
