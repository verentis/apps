{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/legal-matters/v1/matter.schema.json",
  "title": "Legal Matters matter",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/legal-matters/v1/matter.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "matter"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "revision": {
      "type": "string",
      "format": "uuid"
    },
    "pilot": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "intake",
        "screened",
        "declined",
        "open"
      ]
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "client",
              "counterparty",
              "related"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "crm": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          },
          "aliases": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "role",
          "name",
          "crm",
          "aliases"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "team": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 100
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "document",
              "task",
              "deadline"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          },
          "date": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          }
        },
        "required": [
          "kind",
          "description",
          "path",
          "date"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "project": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "engagement": {
      "type": "string",
      "maxLength": 5000
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "employee": {
            "type": "string",
            "maxLength": 200
          },
          "effective": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          },
          "amount": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          }
        },
        "required": [
          "employee",
          "effective",
          "amount"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "fixedFee": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "reviewBy": {
      "type": "string",
      "maxLength": 200
    },
    "reviewReason": {
      "type": "string",
      "maxLength": 2000
    },
    "disposition": {
      "enum": [
        "undecided",
        "clear",
        "waiver-reviewed",
        "decline"
      ]
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "time",
              "recoverable-expense",
              "fixed-fee"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          },
          "release": {
            "type": "string",
            "maxLength": 500
          },
          "writeDown": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "recoverability": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "source",
          "path",
          "release",
          "writeDown",
          "reason",
          "recoverability"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "billingReviewer": {
      "type": "string",
      "maxLength": 200
    },
    "chronology": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "invoices": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^(/.*)?$"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "screen": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "maxLength": 64
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "fingerprint",
        "count",
        "at"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "signature": {
          "type": "string",
          "maxLength": 64
        },
        "by": {
          "type": "string",
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "at": {
          "type": "string",
          "maxLength": 40
        },
        "outcome": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "signature",
        "by",
        "reason",
        "at",
        "outcome"
      ],
      "additionalProperties": false
    },
    "prebill": {
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "revision",
    "title",
    "status",
    "parties",
    "team",
    "links",
    "project",
    "engagement",
    "currency",
    "rates",
    "fixedFee",
    "reviewBy",
    "reviewReason",
    "disposition",
    "charges",
    "billingReviewer",
    "chronology",
    "invoices"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
