# Standalone development mode
# These are only needed when running the app outside the Verentis workspace iframe.
NUXT_PUBLIC_VERENTIS_API_URL=http://localhost:6500
NUXT_PUBLIC_VERENTIS_API_KEY=vrt_your_api_key_here

# Optional: serve the dev server over HTTPS (needed when embedded in the Verentis
# workspace iframe). When launched via the platform Aspire AppHost these are injected
# automatically; set them manually only for standalone HTTPS dev.
# NUXT_HTTPS_CERT=/absolute/path/to/localtest.me.pem
# NUXT_HTTPS_KEY=/absolute/path/to/localtest.me-key.pem
