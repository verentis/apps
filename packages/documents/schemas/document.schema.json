{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/documents/v1/document.schema.json",
  "title": "Documents document card",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/documents/v1/document.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "document"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "filePath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "workspace": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 50
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "inbox",
        "in-review",
        "validated",
        "archived-status"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "reviewComment": {
      "type": "string",
      "maxLength": 2000
    },
    "validatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "title",
    "filePath",
    "workspace",
    "tags",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "validated",
              "archived-status"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validatedAt": true
        },
        "required": [
          "validatedAt"
        ]
      }
    }
  ]
}
