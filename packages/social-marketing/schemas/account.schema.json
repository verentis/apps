{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/social-marketing/v1/account.schema.json",
  "title": "Social Marketing social account",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/social-marketing/v1/account.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "account"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "network": {
      "enum": [
        "mastodon",
        "linkedin",
        "x",
        "facebook",
        "other"
      ]
    },
    "handle": {
      "type": "string",
      "maxLength": 1000
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "network",
    "handle",
    "active"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
