{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/social-marketing/v1/post.schema.json",
  "title": "Social Marketing post",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/social-marketing/v1/post.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "post"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "account": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "content": {
      "type": "string",
      "maxLength": 5000
    },
    "mediaNote": {
      "type": "string",
      "maxLength": 500
    },
    "status": {
      "enum": [
        "draft",
        "scheduled",
        "published",
        "cancelled"
      ]
    },
    "scheduledDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "engagement": {
      "type": "object",
      "properties": {
        "likes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "shares": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "likes",
        "shares",
        "comments"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "status",
    "engagement"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "published"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "publishedAt": true
        },
        "required": [
          "publishedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancelledAt": true
        },
        "required": [
          "cancelledAt"
        ]
      }
    }
  ]
}
