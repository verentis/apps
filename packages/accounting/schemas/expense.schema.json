{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/accounting/v1/expense.schema.json",
  "title": "Accounting expense",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/accounting/v1/expense.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "expense"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "payee": {
      "type": "string",
      "maxLength": 1000
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "netAmount": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "taxAmount": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "grossAmount": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "taxCode": {
      "type": "string",
      "maxLength": 32
    },
    "expenseAccount": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "paymentAccount": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "status": {
      "enum": [
        "draft",
        "posted",
        "reversed"
      ]
    },
    "journal": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "reversalJournal": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "postedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "reversedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "date",
    "description",
    "currency",
    "netAmount",
    "taxAmount",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "posted",
              "reversed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "journal": true,
          "postedAt": true,
          "grossAmount": true
        },
        "required": [
          "journal",
          "postedAt",
          "grossAmount"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "reversed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reversalJournal": true,
          "reversedAt": true
        },
        "required": [
          "reversalJournal",
          "reversedAt"
        ]
      }
    }
  ]
}
