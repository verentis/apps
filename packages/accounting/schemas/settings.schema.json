{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/accounting/v1/settings.schema.json",
  "title": "Accounting settings",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/accounting/v1/settings.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "country": {
      "type": "string",
      "pattern": "^([A-Z]{2})?$"
    },
    "baseCurrency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "minorDigits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "fiscalYearStartMonth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "taxCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 1000
          },
          "ratePercent": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          },
          "account": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          }
        },
        "required": [
          "code",
          "name",
          "ratePercent",
          "account"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "baseCurrency",
    "minorDigits",
    "fiscalYearStartMonth",
    "taxCodes"
  ],
  "additionalProperties": false
}
