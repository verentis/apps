{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/plm/v1/eco.schema.json",
  "title": "PLM engineering change order",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/plm/v1/eco.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "eco"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "type": {
      "enum": [
        "new-product",
        "change",
        "obsolete"
      ]
    },
    "product": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "stage": {
      "enum": [
        "draft",
        "in-review",
        "approved",
        "applied",
        "rejected"
      ]
    },
    "approver": {
      "type": "string",
      "maxLength": 200
    },
    "effectiveDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "rejectionReason": {
      "type": "string",
      "maxLength": 1000
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "rejectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "title",
    "type",
    "product",
    "priority",
    "stage",
    "approver",
    "effectiveDate",
    "description",
    "rejectionReason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "in-review",
              "approved",
              "applied",
              "rejected"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "submittedAt": true
        },
        "required": [
          "submittedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "approved",
              "applied"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "approver": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "approvedAt",
          "approver"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "applied"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "appliedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "effectiveDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "appliedAt",
          "effectiveDate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "rejected"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "rejectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "rejectionReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "rejectedAt",
          "rejectionReason"
        ]
      }
    }
  ]
}
