{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/discuss/v1/thread.schema.json",
  "title": "Discuss thread",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/discuss/v1/thread.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "thread"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "channel": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "subject": {
      "type": "string",
      "maxLength": 1000
    },
    "startedBy": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "locked"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "author": {
            "type": "string",
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "edited": {
            "type": "boolean"
          },
          "key": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "sequence",
          "author",
          "date",
          "body",
          "edited"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "draft": {
      "type": "string",
      "maxLength": 20000
    },
    "postAs": {
      "type": "string",
      "maxLength": 200
    },
    "lastActivityAt": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "channel",
    "subject",
    "status",
    "messages"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "resolved",
              "locked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolvedAt": true
        },
        "required": [
          "resolvedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "locked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lockedAt": true
        },
        "required": [
          "lockedAt"
        ]
      }
    }
  ]
}
