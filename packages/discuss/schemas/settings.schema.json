{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/discuss/v1/settings.schema.json",
  "title": "Discuss settings",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/discuss/v1/settings.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultChannel": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "defaultChannel"
  ],
  "additionalProperties": false
}
