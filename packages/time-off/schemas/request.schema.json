{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/time-off/v1/request.schema.json",
  "title": "Time Off leave request",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/time-off/v1/request.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "request"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "employeeName": {
      "type": "string",
      "maxLength": 200
    },
    "employeeRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "type": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "startDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "days": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "refused"
      ]
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "approver": {
      "type": "string",
      "maxLength": 200
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "refusalReason": {
      "type": "string",
      "maxLength": 1000
    },
    "refusedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "employeeName",
    "employeeRef",
    "type",
    "startDate",
    "endDate",
    "days",
    "reason",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "submitted",
              "approved",
              "refused"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "submittedAt": true
        },
        "required": [
          "submittedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approver": true,
          "approvedAt": true
        },
        "required": [
          "approver",
          "approvedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "refused"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusalReason": true,
          "refusedAt": true
        },
        "required": [
          "refusalReason",
          "refusedAt"
        ]
      }
    }
  ]
}
