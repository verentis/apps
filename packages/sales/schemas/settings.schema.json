{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/sales/v1/settings.schema.json",
  "title": "Sales settings",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/sales/v1/settings.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "currency",
    "notes"
  ],
  "additionalProperties": false
}
