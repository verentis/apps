{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/purchase/v1/vendor.schema.json",
  "title": "Purchase vendor",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/purchase/v1/vendor.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "vendor"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "legalName": {
      "type": "string",
      "maxLength": 200
    },
    "contactName": {
      "type": "string",
      "maxLength": 200
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "phone": {
      "type": "string",
      "maxLength": 100
    },
    "taxIdentifier": {
      "type": "string",
      "maxLength": 100
    },
    "address": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 5
        },
        "city": {
          "type": "string",
          "maxLength": 1000
        },
        "region": {
          "type": "string",
          "maxLength": 1000
        },
        "postalCode": {
          "type": "string",
          "maxLength": 32
        },
        "country": {
          "type": "string",
          "pattern": "^([A-Z]{2})?$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "paymentTermsDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "email",
    "paymentTermsDays",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
