{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/purchase/v1/settings.schema.json",
  "title": "Purchase settings",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/purchase/v1/settings.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultCurrency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "defaultLeadDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "defaultCurrency",
    "defaultLeadDays",
    "notes"
  ],
  "additionalProperties": false
}
