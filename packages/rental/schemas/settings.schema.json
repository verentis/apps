{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/rental/v1/settings.schema.json",
  "title": "Rental settings",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/rental/v1/settings.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "dailyLateRate": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "currency",
    "dailyLateRate",
    "notes"
  ],
  "additionalProperties": false
}
