{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/payroll/v1/structure.schema.json",
  "title": "Payroll salary structure",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/payroll/v1/structure.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "structure"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*)?$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "earning",
              "deduction",
              "employer-contribution"
            ]
          },
          "computation": {
            "enum": [
              "fixed",
              "percent-of-base"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          },
          "rate": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          },
          "sequence": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          }
        },
        "required": [
          "code",
          "name",
          "kind",
          "computation",
          "amount",
          "rate",
          "sequence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "rules"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
