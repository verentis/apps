{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/invoicing/v1/invoice.schema.json",
  "title": "Invoicing invoice",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/invoicing/v1/invoice.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "invoice"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "issueDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "dueDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "reference": {
      "type": "string",
      "maxLength": 200
    },
    "customerRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "customer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "legalName": {
          "type": "string",
          "maxLength": 1000
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^([^@\\s]+@[^@\\s]+)?$"
        },
        "phone": {
          "type": "string",
          "maxLength": 100
        },
        "taxIdentifier": {
          "type": "string",
          "maxLength": 100
        },
        "address": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 5
            },
            "city": {
              "type": "string",
              "maxLength": 1000
            },
            "region": {
              "type": "string",
              "maxLength": 1000
            },
            "postalCode": {
              "type": "string",
              "maxLength": 32
            },
            "country": {
              "type": "string",
              "pattern": "^([A-Z]{2})?$"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "seller": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "legalName": {
          "type": "string",
          "maxLength": 1000
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^([^@\\s]+@[^@\\s]+)?$"
        },
        "phone": {
          "type": "string",
          "maxLength": 100
        },
        "taxIdentifier": {
          "type": "string",
          "maxLength": 100
        },
        "address": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 5
            },
            "city": {
              "type": "string",
              "maxLength": 1000
            },
            "region": {
              "type": "string",
              "maxLength": 1000
            },
            "postalCode": {
              "type": "string",
              "maxLength": 32
            },
            "country": {
              "type": "string",
              "pattern": "^([A-Z]{2})?$"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "quantity": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          },
          "taxRate": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          }
        },
        "required": [
          "description",
          "quantity",
          "unitPrice",
          "taxRate"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 500
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "status": {
      "enum": [
        "draft",
        "issued"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "totals": {
      "type": "object",
      "properties": {
        "net": {
          "type": "string",
          "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
        },
        "tax": {
          "type": "string",
          "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
        },
        "gross": {
          "type": "string",
          "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
        }
      },
      "required": [
        "net",
        "tax",
        "gross"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "issueDate",
    "dueDate",
    "currency",
    "customer",
    "lines",
    "notes",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "issued"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issuedAt": true,
          "totals": true,
          "journal": true,
          "document": true,
          "seller": true
        },
        "required": [
          "issuedAt",
          "totals",
          "journal",
          "document",
          "seller"
        ]
      }
    }
  ]
}
