{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/events/v1/registration.schema.json",
  "title": "Events registration",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/events/v1/registration.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "registration"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "event": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "attendeeName": {
      "type": "string",
      "maxLength": 1000
    },
    "attendeeEmail": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "qty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "attended",
        "cancelled"
      ]
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "event",
    "attendeeName",
    "attendeeEmail",
    "qty",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "attended"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confirmedAt": true
        },
        "required": [
          "confirmedAt"
        ]
      }
    }
  ]
}
