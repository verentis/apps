{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/helpdesk/v1/ticket.schema.json",
  "title": "Helpdesk ticket",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/helpdesk/v1/ticket.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ticket"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "team": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "subject": {
      "type": "string",
      "maxLength": 1000
    },
    "customerRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "customerName": {
      "type": "string",
      "maxLength": 200
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "stage": {
      "enum": [
        "new",
        "in-progress",
        "waiting",
        "solved",
        "closed"
      ]
    },
    "slaDeadline": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
    },
    "assignee": {
      "type": "string",
      "maxLength": 200
    },
    "assigneeRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "resolution": {
      "type": "string",
      "maxLength": 10000
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "subject",
    "priority",
    "stage"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "solved",
              "closed"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "resolution": true,
          "resolvedAt": true
        },
        "required": [
          "resolution",
          "resolvedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "closed"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "closedAt": true
        },
        "required": [
          "closedAt"
        ]
      }
    }
  ]
}
