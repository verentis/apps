{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": ["app/lib/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
