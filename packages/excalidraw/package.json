{
  "name": "@verentis/app-excalidraw",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "playwright test",
    "test:browser:native": "playwright test --grep 'synthetic authenticated bridge'",
    "test:performance": "PERFORMANCE=1 playwright test --grep 'original desktop fixture'",
    "assets": "node scripts/copy-assets.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@verentis/sdk": "^1.1.0",
    "nuxt": "^4.6.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
