{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/recruitment/v1/candidate.schema.json",
  "title": "Recruitment candidate",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/recruitment/v1/candidate.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 1000
    },
    "job": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "phone": {
      "type": "string",
      "maxLength": 50
    },
    "source": {
      "enum": [
        "website",
        "referral",
        "linkedin",
        "email",
        "agency",
        "other"
      ]
    },
    "stage": {
      "enum": [
        "new",
        "screening",
        "interview",
        "offer",
        "hired",
        "refused"
      ]
    },
    "expectedSalary": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "refusalReason": {
      "type": "string",
      "maxLength": 2000
    },
    "hiredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "source",
    "stage"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "refused"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "refusalReason": true
        },
        "required": [
          "refusalReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "hired"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "hiredAt": true
        },
        "required": [
          "hiredAt"
        ]
      }
    }
  ]
}
