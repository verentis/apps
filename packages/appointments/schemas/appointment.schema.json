{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/appointments/v1/appointment.schema.json",
  "title": "Appointments appointment",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/appointments/v1/appointment.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "appointment"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "type": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "guestName": {
      "type": "string",
      "maxLength": 200
    },
    "guestEmail": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "startTime": {
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
    },
    "endTime": {
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
    },
    "host": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "booked",
        "confirmed",
        "done",
        "cancelled",
        "no-show"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "noShowAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "type",
    "guestName",
    "guestEmail",
    "date",
    "startTime",
    "endTime",
    "host",
    "status",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "done"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confirmedAt": true
        },
        "required": [
          "confirmedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "done"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completedAt": true
        },
        "required": [
          "completedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancelledAt": true
        },
        "required": [
          "cancelledAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "no-show"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "noShowAt": true
        },
        "required": [
          "noShowAt"
        ]
      }
    }
  ]
}
