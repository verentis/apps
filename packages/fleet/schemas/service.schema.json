{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/fleet/v1/service.schema.json",
  "title": "Fleet service log",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/fleet/v1/service.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "service"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "vehicle": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "odometerKm": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "type": {
      "enum": [
        "maintenance",
        "repair",
        "inspection",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "cost": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "status": {
      "enum": [
        "draft",
        "done"
      ]
    },
    "doneAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "vehicle",
    "date",
    "odometerKm",
    "type",
    "description",
    "cost",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "done"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "doneAt": true
        },
        "required": [
          "doneAt"
        ]
      }
    }
  ]
}
