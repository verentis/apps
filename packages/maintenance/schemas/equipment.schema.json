{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/maintenance/v1/equipment.schema.json",
  "title": "Maintenance equipment",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/maintenance/v1/equipment.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "equipment"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "maxLength": 200
    },
    "serial": {
      "type": "string",
      "maxLength": 200
    },
    "location": {
      "type": "string",
      "maxLength": 200
    },
    "assignedTo": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "operational",
        "under-maintenance",
        "scrapped"
      ]
    },
    "purchaseDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "warrantyEnd": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "category",
    "serial",
    "location",
    "assignedTo",
    "status",
    "purchaseDate",
    "warrantyEnd"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
