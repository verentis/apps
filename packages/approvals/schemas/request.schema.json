{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/approvals/v1/request.schema.json",
  "title": "Approvals approval request",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/approvals/v1/request.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "request"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "type": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "requester": {
      "type": "string",
      "maxLength": 200
    },
    "requesterRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "amount": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "reference": {
      "type": "string",
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "refused",
        "cancelled"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approver": {
            "type": "string",
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "decision": {
            "enum": [
              "approve",
              "refuse"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "approver",
          "date",
          "decision",
          "comment"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "type",
    "title",
    "requester",
    "amount",
    "date",
    "reference",
    "reason",
    "status",
    "approvals"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "submitted",
              "approved",
              "refused"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "submittedAt": true
        },
        "required": [
          "submittedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "refused"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decidedAt": true
        },
        "required": [
          "decidedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancelledAt": true
        },
        "required": [
          "cancelledAt"
        ]
      }
    }
  ]
}
