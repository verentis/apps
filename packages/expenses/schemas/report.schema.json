{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/expenses/v1/report.schema.json",
  "title": "Expenses expense report",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/expenses/v1/report.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "report"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "employeeName": {
      "type": "string",
      "maxLength": 200
    },
    "employeeRef": {
      "type": "string",
      "maxLength": 100
    },
    "employeeRecord": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "amount": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          },
          "date": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          }
        },
        "required": [
          "category",
          "description",
          "amount",
          "date"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "maxLength": 400000,
            "pattern": "^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$"
          },
          "takenAt": {
            "type": "string",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "refused",
        "posted"
      ]
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "total": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "approver": {
      "type": "string",
      "maxLength": 200
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "refusalReason": {
      "type": "string",
      "maxLength": 1000
    },
    "refusedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "postedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "journal": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "employeeName",
    "employeeRef",
    "date",
    "lines",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "submitted",
              "approved",
              "refused",
              "posted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "submittedAt": true,
          "total": true
        },
        "required": [
          "submittedAt",
          "total"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "posted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approver": true,
          "approvedAt": true
        },
        "required": [
          "approver",
          "approvedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "refused"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusalReason": true,
          "refusedAt": true
        },
        "required": [
          "refusalReason",
          "refusedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "posted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "postedAt": true,
          "journal": true
        },
        "required": [
          "postedAt",
          "journal"
        ]
      }
    }
  ]
}
