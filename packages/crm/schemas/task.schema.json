{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/crm/v1/task.schema.json",
  "title": "CRM task",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/crm/v1/task.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "task"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "subject": {
      "type": "string",
      "maxLength": 1000
    },
    "regarding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "not-started",
        "in-progress",
        "completed",
        "deferred"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "dueDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "subject",
    "status",
    "priority"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "completedAt"
        ]
      }
    }
  ]
}
