{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/crm/v1/contact.schema.json",
  "title": "CRM contact",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/crm/v1/contact.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "contact"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "salutation": {
      "type": "string",
      "maxLength": 50
    },
    "givenName": {
      "type": "string",
      "maxLength": 1000
    },
    "familyName": {
      "type": "string",
      "maxLength": 1000
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "phone": {
      "type": "string",
      "maxLength": 100
    },
    "mobile": {
      "type": "string",
      "maxLength": 100
    },
    "jobTitle": {
      "type": "string",
      "maxLength": 1000
    },
    "department": {
      "type": "string",
      "maxLength": 1000
    },
    "company": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 5
        },
        "city": {
          "type": "string",
          "maxLength": 1000
        },
        "region": {
          "type": "string",
          "maxLength": 1000
        },
        "postalCode": {
          "type": "string",
          "maxLength": 32
        },
        "country": {
          "type": "string",
          "pattern": "^([A-Z]{2})?$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "givenName"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
