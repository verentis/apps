{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/crm/v1/deal.schema.json",
  "title": "CRM deal",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/crm/v1/deal.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "deal"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "customer": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "stageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "currency": {
      "type": "string",
      "pattern": "^([A-Z]{3})?$"
    },
    "probability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expectedCloseDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "outcome": {
      "enum": [
        "open",
        "won",
        "lost"
      ]
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lostReason": {
      "type": "string",
      "maxLength": 1000
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "title",
    "stageId",
    "amount",
    "currency",
    "outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
