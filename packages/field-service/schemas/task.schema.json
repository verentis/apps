{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/field-service/v1/task.schema.json",
  "title": "Field Service field task",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/field-service/v1/task.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "task"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "customerName": {
      "type": "string",
      "maxLength": 200
    },
    "customerRef": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "address": {
      "type": "string",
      "maxLength": 500
    },
    "scheduledDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "windowStart": {
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
    },
    "windowEnd": {
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
    },
    "technician": {
      "type": "string",
      "maxLength": 200
    },
    "type": {
      "enum": [
        "install",
        "repair",
        "inspection"
      ]
    },
    "stage": {
      "enum": [
        "new",
        "scheduled",
        "on-site",
        "done",
        "cancelled"
      ]
    },
    "workLog": {
      "type": "string",
      "maxLength": 10000
    },
    "hours": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "quantity": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
          }
        },
        "required": [
          "description",
          "quantity",
          "unitPrice"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "materialsTotal": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?)?$"
    },
    "invoice": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "customerName",
    "address",
    "scheduledDate",
    "windowStart",
    "windowEnd",
    "technician",
    "type",
    "stage",
    "workLog",
    "hours",
    "materials",
    "materialsTotal"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "done"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "completedAt": true
        },
        "required": [
          "completedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "cancelled"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "cancelledAt": true
        },
        "required": [
          "cancelledAt"
        ]
      }
    }
  ]
}
