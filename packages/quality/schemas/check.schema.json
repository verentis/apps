{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/quality/v1/check.schema.json",
  "title": "Quality quality check",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/quality/v1/check.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "check"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "reference": {
      "type": "string",
      "maxLength": 200
    },
    "result": {
      "enum": [
        "pending",
        "pass",
        "fail"
      ]
    },
    "measuredValue": {
      "type": "string",
      "pattern": "^((0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?)?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "alert": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "point",
    "date",
    "reference",
    "result",
    "measuredValue",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "checkedAt": true
        },
        "required": [
          "checkedAt"
        ]
      }
    }
  ]
}
