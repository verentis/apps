{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/employees/v1/employee.schema.json",
  "title": "Employees employee",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/employees/v1/employee.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "employee"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 1000
    },
    "jobTitle": {
      "type": "string",
      "maxLength": 200
    },
    "department": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "manager": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "workEmail": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^([^@\\s]+@[^@\\s]+)?$"
    },
    "workPhone": {
      "type": "string",
      "maxLength": 50
    },
    "startDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "status": {
      "enum": [
        "active",
        "on-leave",
        "terminated"
      ]
    },
    "terminationDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "terminatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "jobTitle",
    "department",
    "manager",
    "workEmail",
    "workPhone",
    "startDate",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "terminated"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "terminationDate": true,
          "terminatedAt": true
        },
        "required": [
          "terminationDate",
          "terminatedAt"
        ]
      }
    }
  ]
}
