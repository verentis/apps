{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/spreadsheet-bi/v1/snapshot.schema.json",
  "title": "Spreadsheet BI snapshot",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/spreadsheet-bi/v1/snapshot.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "snapshot"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dashboard": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(/.*)?$"
    },
    "takenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^[0-9]{1,4}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "value": {
            "type": "string",
            "maxLength": 64
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 200
                },
                "value": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 500
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "sequence",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "status": {
      "enum": [
        "draft",
        "taken"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "dashboard",
    "results",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "taken"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "takenAt": true,
          "results": true
        },
        "required": [
          "takenAt",
          "results"
        ]
      }
    }
  ]
}
