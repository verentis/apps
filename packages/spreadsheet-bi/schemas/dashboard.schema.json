{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.verentis.io/spreadsheet-bi/v1/dashboard.schema.json",
  "title": "Spreadsheet BI dashboard",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://schemas.verentis.io/spreadsheet-bi/v1/dashboard.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "dashboard"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^[0-9]{1,4}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(/.*)?$"
          },
          "kind": {
            "enum": [
              "count",
              "sum",
              "group-count",
              "group-sum"
            ]
          },
          "valueField": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^([A-Za-z0-9_$]+(\\.[A-Za-z0-9_$]+)*)?$"
          },
          "groupByField": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^([A-Za-z0-9_$]+(\\.[A-Za-z0-9_$]+)*)?$"
          },
          "filter": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^([A-Za-z0-9_$]+(\\.[A-Za-z0-9_$]+)*)?$"
              },
              "equals": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "sequence",
          "title",
          "source",
          "kind",
          "valueField",
          "groupByField"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "state",
    "createdAt",
    "updatedAt",
    "code",
    "name",
    "description",
    "tiles"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "archived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "archivedAt"
        ]
      }
    }
  ]
}
